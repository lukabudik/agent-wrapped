  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "stats",
    "svg",
    "wrapped"
  ],
  "author": "Luka Budik (https://github.com/lukabudik)",
  "license": "MIT",
  "homepage": "https://agentwrapped.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukabudik/agent-wrapped.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/lukabudik/agent-wrapped/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {

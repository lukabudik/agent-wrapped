# PostgreSQL connection string. Railway injects this automatically when the
# Postgres plugin is attached; locally, point it at your own instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agent_wrapped?schema=public"

# GitHub OAuth app credentials. The CLI runs the device flow against these, so
# the OAuth app must have "Device flow" enabled. The web service itself only
# needs them to identify which app issued a token.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Public origin of the deployment. Used for OG image URLs and for the README
# markdown snippet shown on the landing page.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

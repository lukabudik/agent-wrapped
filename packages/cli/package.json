{
  "name": "agent-wrapped",
  "version": "0.1.0",
  "description": "Turn your local Claude Code and Codex session logs into a shareable stats card.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-wrapped": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "stats",
    "readme",
    "wrapped"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@agent-wrapped/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2"
  },
  "author": "Luka Budik (https://github.com/lukabudik)",
  "homepage": "https://agentwrapped.dev",
  "bugs": {
    "url": "https://github.com/lukabudik/agent-wrapped/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukabudik/agent-wrapped.git",
    "directory": "packages/cli"
  }
}

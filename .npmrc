# Fail loudly if the local Node/pnpm does not match what the workspace declares.
engine-strict=true

# Workspace deps resolve to the local package, not the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Next.js and friends ship peer ranges that lag their own releases; install the
# peers but do not turn a mismatch into an install failure.
auto-install-peers=true
strict-peer-dependencies=false
